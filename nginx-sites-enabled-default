server {

  server_name newdata.caltechlibrary.dev;

  add_header Strict-Transport-Security "max-age=15768000"; # 6 months

  # Request ID tracing (allows end-to-end tracking of requests for better
  # troubleshooting)
  add_header X-Request-ID $request_id;

  # The request body is sent to the proxied server immediately as it is
  # received
  proxy_request_buffering off;  
  # Sets the HTTP protocol v1.1 for proxying in order to not use the buffer
  # in case of chunked transfer encoding
  proxy_http_version 1.1;

  # Proxying to the application server (Granian, plain HTTP; this was uWSGI's
  # uwsgi protocol before the Granian move).
  proxy_buffering off;

  ## UI server
  location / {
    proxy_pass http://127.0.0.1:5000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Pass request id to the ui server
    proxy_set_header X-Request-ID $request_id;
    # X-Session-ID / X-User-ID is read by nginx and included in the logs,
    # however we don't want to expose them to clients so we are hiding them.
    proxy_hide_header X-Session-ID;
    proxy_hide_header X-User-ID;
    # Max upload size (except for files) is set to 100mb as default.
    client_max_body_size 100m;
  }
  ## Most API
  # No trailing slash on proxy_pass: nginx forwards /api/... unmodified and
  # Granian's --url-path-prefix /api in rdm_rest.service strips it. The two are
  # a matched pair (caltechauthors DR-0007): change one without the other and
  # every /api request breaks.
  location /api {
    proxy_pass http://127.0.0.1:5001;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Pass request id to the api server
    proxy_set_header X-Request-ID $request_id;
    proxy_hide_header X-Session-ID;
    proxy_hide_header X-User-ID;
    # Max upload size (except for files) is set to 100mb as default.
    client_max_body_size 100m;
  }
  ## API files
  # Another location is defined in order to allow large file uploads in the files
  # API without exposing the other parts of the application to receive huge
  # request bodies. Optional trailing /<part-number> and slash match the
  # multipart file-content requests.
  location ~ ^/api/records/.+/draft/files/.+/content(?:/[0-9]+)?/?$ {
    gzip off;
    proxy_pass http://127.0.0.1:5001;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Pass request id to api server
    proxy_set_header X-Request-ID $request_id;
    proxy_hide_header X-Session-ID;
    proxy_hide_header X-User-ID;
    # Max upload size for files is set to 500GB (configure as needed).
    client_max_body_size 500G;
    # uWSGI's 120 s socket timeouts no longer apply; these do. A starting
    # point, to be set from the Stage 1 large-upload test (caltechdata DR-0001).
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
  # Static content is served directly by nginx and not the application server.
  # location /static {
  #  alias /home/tmorrell/.local/share/virtualenvs/caltechauthors-irdMlMEM/var/instance/static;
  #  autoindex off;
  #}


}

server {
    if ($host = newdata.caltechlibrary.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot



  server_name newdata.caltechlibrary.dev;

  add_header Strict-Transport-Security "max-age=15768000";
    listen 80;
    return 404; # managed by Certbot


}
