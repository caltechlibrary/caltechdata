# Environment for CaltechDATA.
#
# Copy to /Sites/caltechdata/.env (gitignored) and fill in the blanks,
# then `chmod 600 .env`. rdm.service, rdm_rest.service and rdm_celery.service
# load it via EnvironmentFile=.
#
# Any INVENIO_<NAME> variable overrides the <NAME> setting in invenio.cfg,
# e.g. INVENIO_SECRET_KEY sets SECRET_KEY. Values below are for the
# bare-metal layout: the app runs on the host and the backing services
# (docker-services.yml) are port-mapped to localhost.
#
# Lines starting with # and blank lines are ignored. Keep this file and the
# .env block in cloud-init.yaml and cloud-init-multipass.yaml in step.

# --- Flask / logging --------------------------------------------------------

# Required secret. Generate with `makepasswd -char 64`; changing it logs
# everyone out.
INVENIO_SECRET_KEY=

FLASK_ENV=production
INVENIO_LOGGING_CONSOLE_LEVEL=INFO
# Optional. Sentry error reporting; leave blank to disable. Setting it up is a
# post-install step, not part of building an instance.
INVENIO_SENTRY_DSN=

# --- PostgreSQL -------------------------------------------------------------

INVENIO_SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://caltechdata:caltechdata@localhost/caltechdata

# --- Redis ------------------------------------------------------------------
# One DB index per use: 0=cache, 1=sessions, 2=Celery results,
# 3=rate limits, 4=communities identities cache.

INVENIO_CACHE_TYPE=redis
INVENIO_CACHE_REDIS_URL=redis://localhost:6379/0
INVENIO_ACCOUNTS_SESSION_REDIS_URL=redis://localhost:6379/1
INVENIO_CELERY_RESULT_BACKEND=redis://localhost:6379/2
INVENIO_RATELIMIT_STORAGE_URL=redis://localhost:6379/3
INVENIO_COMMUNITIES_IDENTITIES_CACHE_REDIS_URL=redis://localhost:6379/4

# --- RabbitMQ ---------------------------------------------------------------

INVENIO_BROKER_URL=amqp://guest:guest@localhost:5672/
INVENIO_CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/

# --- OpenSearch -------------------------------------------------------------

INVENIO_SEARCH_HOSTS=["localhost:9200"]

# --- S3 file storage (OSN) --------------------------------------------------
# Secrets. The endpoint is set in invenio.cfg. Leave these blank on a test
# instance and use local storage instead (see the test-instance section).

INVENIO_S3_ACCESS_KEY_ID=
INVENIO_S3_SECRET_ACCESS_KEY=

# --- Mail -------------------------------------------------------------------
# Secret. Password for MAIL_USERNAME in invenio.cfg.

INVENIO_MAIL_PASSWORD=

# --- DataCite ---------------------------------------------------------------
# Secret. Production mints DOIs; see the test-instance section for turning that off.

INVENIO_DATACITE_PASSWORD=

# --- Test instances only ----------------------------------------------------
# cloud-init writes these on a Multipass or test instance. Leave them out on
# production.
#
# Local file storage instead of S3/OSN, so a test instance cannot write to OSN.
# This is half of it: the default files location in the database must also be
# a local path, which cloud-init's setup script creates (services setup
# creates s3://default).
#   INVENIO_FILES_REST_STORAGE_FACTORY=invenio_files_rest.storage.pyfs_storage_factory
#
# A test instance must not mint DOIs (invenio.cfg has DATACITE_ENABLED = True).
#   INVENIO_DATACITE_ENABLED=false
#
# invenio.cfg trusts only data.caltech.edu. To browse a test instance, list
# the names and addresses it answers to, then restart rdm and rdm_rest.
#   INVENIO_TRUSTED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]
