[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
check-manifest = ">=0.25"

[packages]
uwsgitop = ">=0.11"
uwsgi-tools = ">=1.1.1"
invenio-saml = "*"
invenio-logging = {extras = ["sentry"]}
invenio-app-rdm = {version = "~=13.0.0", extras = ["opensearch2", "s3"]}
uwsgi = "*"

[requires]
python_version = "3.12"

[pipenv]
allow_prereleases = false
