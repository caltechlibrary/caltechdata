[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
check-manifest = ">=0.25"

[packages]
pyuwsgi = ">=2.0"
uwsgitop = ">=0.11"
uwsgi-tools = ">=1.1.1"
invenio-saml = "*"
flask-babel = "2.0.0"
invenio-app-rdm = {version = "~=11.0.0", extras = ["opensearch2", "postgresql"]}

[requires]
python_version = "3.9"

[pipenv]
allow_prereleases = false
