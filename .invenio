[cli]
flavour = RDM
logfile = /logs/invenio-cli.log
python_package_manager = uv

[cookiecutter]
project_name = CaltechDATA
project_shortname = caltechdata
project_site = data.caltech.edu
github_repo = caltechlibrary/caltechdata
description = Caltech Research Data Repository
author_name = Caltech Library
author_email = data@caltech.edu
year = 2024
python_version = 3.9
database = postgresql
search = opensearch2
file_storage = S3
development_tools = yes
_template = https://github.com/inveniosoftware/cookiecutter-invenio-rdm.git
_output_dir = /Sites

