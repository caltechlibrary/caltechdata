[Unit]
Description=Launch InvenioRDM Web Interface

[Service]
Type=simple
User=tmorrell
StandardOutput=kmsg
StandardError=kmsg
WorkingDirectory=/Sites/caltechdata
EnvironmentFile=/Sites/caltechdata/.env
Environment="PATH=/Sites/caltechdata/uv-3.9/bin"
ExecStart=/Sites/caltechdata/uv-3.9/bin/pipenv run /Sites/caltechdata/uv-3.9/bin/uwsgi --logger syslog:inveniordm_ui uwsgi_ui.ini

[Install]
WantedBy=multi-user.target
