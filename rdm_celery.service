[Unit]
Description=Launch InvenioRDM Celery Task

[Service]
Type=simple
User=tmorrell
StandardOutput=kmsg
StandardError=kmsg
WorkingDirectory=/Sites/caltechdata
EnvironmentFile=/Sites/caltechdata/.env
Environment="PATH=/Sites/caltechdata/uv-3.9/bin"
ExecStart=/Sites/caltechdata/uv-3.9/bin/pipenv run /Sites/caltechdata/uv-3.9/bin/celery --app invenio_app.celery worker --beat --events --loglevel INFO

[Install]
WantedBy=multi-user.target
