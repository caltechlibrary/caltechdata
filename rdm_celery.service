[Unit]
Description=Launch InvenioRDM Celery Task

[Service]
Type=simple
User=ubuntu
StandardOutput=kmsg
StandardError=kmsg
WorkingDirectory=/Sites/caltechdata
EnvironmentFile=/Sites/caltechdata/.env
ExecStart=/Sites/caltechdata/uv-env-39/bin/pipenv run /Sites/caltechdata/uv-env-39/bin/celery --app invenio_app.celery worker --beat --events --loglevel INFO

[Install]
WantedBy=multi-user.target
